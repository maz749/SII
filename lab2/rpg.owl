<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/rpg-labs"
         xmlns="https://example.org/rpg-labs#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="https://example.org/rpg-labs"/>

<owl:ObjectProperty rdf:about="#hasWeapon">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Weapon"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#counters">
  <rdfs:domain rdf:resource="#Weapon"/>
  <rdfs:range rdf:resource="#Enemy"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#beginnerFriendly">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Character">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasWeapon"/>
      <owl:onClass rdf:resource="#Weapon"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Weapon">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#counters"/>
      <owl:onClass rdf:resource="#Enemy"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Enemy">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Melee">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:disjointWith rdf:resource="#Ranged"/>
</owl:Class>

<owl:Class rdf:about="#Ranged">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Damage">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Tank">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Support">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Beginner">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Frontliner">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#Protector">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:Class rdf:about="#RangedDamage">
