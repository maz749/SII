</owl:Class>

<owl:Class rdf:about="#Versatile">
  <rdfs:subClassOf rdf:resource="#Character"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#warrior">
  <rdf:type rdf:resource="#Character"/>
  <rdf:type rdf:resource="#Melee"/>
  <rdf:type rdf:resource="#Damage"/>
  <rdf:type rdf:resource="#Tank"/>
  <rdf:type rdf:resource="#Beginner"/>
  <hasWeapon rdf:resource="#sword"/>
  <beginnerFriendly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</beginnerFriendly>
</owl:NamedIndividual>

